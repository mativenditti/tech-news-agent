# --- LLM (Gemini) ---
# Clave de la API de Google AI (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=AIza...
# Modelo por defecto: gemini-3-flash-preview. Los 2.x están retirados para cuentas
# nuevas (404 "no longer available to new users"). Gemini 3 son modelos "thinking":
# emiten thought_signature, así que requieren langchain-google-genai>=3.1.0 para que
# el tool-calling multi-turno no falle con "400 missing thought_signature".
# Evitá el alias gemini-flash-latest: se mueve solo y puede saltar de versión.
# LLM_MODEL=gemini-3-flash-preview
# Tope de razonamiento ("thinking") de Gemini 3 por respuesta. Gemini 3 razona antes
# de responder aun en lo trivial (un "de nada" gastaba ~416 tokens → ~15s). Bajarlo
# acelera mucho el chat; 0 lo desactiva. El briefing usa su propio budget (más alto)
# porque sí necesita razonar para elegir el "top 3".
# LLM_THINKING_BUDGET=512
# LLM_THINKING_BUDGET_BRIEFING=2048

# --- Web search (Tavily) ---
# Clave gratuita de https://tavily.com — la tool web_search la usa para traer titulares.
TAVILY_API_KEY=tvly-...

# --- LangSmith (tracing / monitoreo) ---
# Con esto, cada run/tool-call/token queda trazado en el dashboard de LangSmith. Sin código extra.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=tech-news-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # (default; descomentar solo si hace falta)

# --- Email ---
# En true, la tool de email NO envía nada: sólo loguea el reporte que se enviaría.
EMAIL_DRY_RUN=true
# Remitente/destinatario por defecto para el reporte.
EMAIL_FROM=tech-news-agent@example.com
EMAIL_TO=me@example.com
# SMTP: sólo aplica con EMAIL_DRY_RUN=false. Ej. Gmail: host smtp.gmail.com, port 587,
# user = tu cuenta, password = un App Password (2FA requerido; el login común está deshabilitado).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true

# --- RAG / embeddings ---
# fake   -> embeddings deterministas locales (PoC, sin dependencias ni costo)
# google -> embeddings reales de Google (models/text-embedding-004, reusa GOOGLE_API_KEY)
EMBEDDINGS_PROVIDER=fake
CHROMA_DIR=./chroma_db

# --- Rate limits (por conversación) ---
MAX_WEB_SEARCH_CALLS=5
MAX_EMAIL_CALLS=2

# --- CORS (para el front React) ---
# Orígenes permitidos, separados por coma. Vite usa 5173, CRA usa 3000.
# En prod agregá el dominio del front. "*" permite todos (solo dev).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
